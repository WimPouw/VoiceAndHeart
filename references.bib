@article{muller-frommeyerConsistencyContextualDependency2020,
  title = {Beyond {{Consistency}}: {{Contextual Dependency}} of {{Language Style}} in {{Monolog}} and {{Conversation}}},
  shorttitle = {Beyond {{Consistency}}},
  author = {{M{\"u}ller-Frommeyer}, Lena C. and Kauffeld, Simone and Paxton, Alexandra},
  year = {2020},
  journal = {Cognitive Science},
  volume = {44},
  number = {4},
  pages = {e12834},
  issn = {1551-6709},
  doi = {10.1111/cogs.12834},
  urldate = {2021-07-12},
  abstract = {Language is highly dynamic: It unfolds over time, and we can use it to achieve a wide variety of communicative goals, from telling a story to trying to persuade another person. One aspect of language that has gained increasing popularity among researchers in the last several decades is the individual language style (LS) represented by an individual's use of function words (e.g., pronouns, articles). Previous approaches to LS mostly focus on LS of one individual in isolation, paying less attention to the fact that language emerges from interaction with others. The aim of this paper is twofold: First, we integrate LS into a dynamical theoretical framework and present an innovative methodological approach. Second, this paper aims to address how interactive conversation\textemdash as an aspect of the communicative setting\textemdash changes an individual's LS. We use recurrence quantification analysis to look at structure in patterns of LS in monologs and conversations of 118 participants. Our results showed that LS significantly differs from monolog to conversation, and post hoc analyses further revealed that the change in LS is greater for conflict than for friendly conversations. The difference between monologs and conversations is reflected more strongly in the dynamics (i.e., structure and complexity) of LS than the proportion of function words used. Theoretical implications and directions for future studies are discussed.},
  langid = {english},
  keywords = {Consistency,Context sensitivity,Dynamical systems theory,Language style,Recurrence quantification analysis},
  file = {C\:\\Users\\wimpo\\Zotero\\storage\\VQBGQXKH\\Müller-Frommeyer et al. - 2020 - Beyond Consistency Contextual Dependency of Langu.pdf;C\:\\Users\\wimpo\\Zotero\\storage\\788SSWWD\\cogs.html}
}

@article{mullerCardiacRespiratoryPatterns2011,
