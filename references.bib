@article{vettoriCombinedFrequencytaggingEEG2020,
  title = {Combined Frequency-Tagging {{EEG}} and Eye-Tracking Measures Provide No Support for the ``Excess Mouth/Diminished Eye Attention'' Hypothesis in Autism},
  author = {Vettori, Sofie and {Van der Donck}, Stephanie and Nys, Jannes and Moors, Pieter and Van Wesemael, Tim and Steyaert, Jean and Rossion, Bruno and Dzhelyova, Milena and Boets, Bart},
