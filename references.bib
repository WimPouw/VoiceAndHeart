@article{fullerInfluenceSpeakerRoles2003,
  title = {The Influence of Speaker Roles on Discourse Marker Use},
  author = {Fuller, Janet M.},
  year = {2003},
  month = jan,
  journal = {Journal of Pragmatics},
  volume = {35},
  number = {1},
  pages = {23--45},
  issn = {0378-2166},
  doi = {10.1016/S0378-2166(02)00065-6},
  urldate = {2020-02-17},
  abstract = {This research examines the use of the discourse markers (DMs) you know, like, oh, well, yeah, and I mean in two speech contexts\textemdash interviews and casual conversations\textemdash to determine their role in marking and negotiating speaker roles. The DMs oh and well show statistically significant differences in rates of use between contexts, with both of these DMs occurring more frequently in conversations. Despite the initial classification of well as a presentation marker, these data indicate that oh and well both function primarily as reception markers and are used in conversations to create coherence between speaker turns. In interviews, the same speakers use oh and well less frequently because their role as interviewee does not require as much response to the other interlocutor's utterances. The DMs you know, like, yeah and I mean were used at similar rates across contexts, indicating that the functions of these presentation markers are more universal.},
  langid = {english},
  keywords = {American English,Conversation,Discourse markers,Interview,Social settings,Speaker/listener}
}

