@incollection{liebermanMotorControlSpeech2003,
  title = {Motor {{Control}}, {{Speech}}, and the {{Evolution}} of {{Human Language}}},
  booktitle = {Language {{Evolution}}},
  author = {Lieberman, Philip},
  year = {2003},
  publisher = {{Oxford University Press}},
  address = {{Oxford}},
  doi = {10.1093/acprof:oso/9780199244843.003.0014},
  urldate = {2021-11-01},
  abstract = {This chapter emphasises the importance of speech production in language evolution. A wide range of neuropsychological and neurophysiological data relevant to explaining the evolution of language are reviewed. The advent of bipedalism was the first step toward the evolution of language, but upright walking would have resulted in biological adaptations of basal ganglia \textemdash{} a collection of subcortical brain structures \textemdash{} for the learning and sequencing of more complex movements. These changes to basal ganglia formed the key adaptation en route to language, a connection supported by different language impairments, including impairments following strokes (aphasia), Parkinson's disease, and disordered language development \textemdash{} all of which appear to involve damage to basal ganglia. However, modern speech would have emerged considerably later in human evolution, based on the fossil record and comparisons with the vocalisation abilities of extant apes. This chapter also contends that speech production may be the crucial factor that differentiates communication in humans and nonhuman primates.},
  isbn = {978-0-19-924484-3},
  langid = {english},
  keywords = {basal ganglia,communication,language,language evolution,language impairments,nonhuman primates,speech production}
}

@article{liebermanPredictionVisualLanguage2018,
  title = {Prediction in a Visual Language: Real-Time Sentence Processing in {{American Sign Language}} across Development},
  shorttitle = {Prediction in a Visual Language},
  author = {Lieberman, Amy M. and Borovsky, Arielle and Mayberry, Rachel I.},
  year = {2018},
  month = apr,
  journal = {Language, Cognition and Neuroscience},
  volume = {33},
  number = {4},
  pages = {387--401},
  issn = {2327-3798, 2327-3801},
  doi = {10.1080/23273798.2017.1411961},
  urldate = {2020-10-29},
  abstract = {Prediction during sign language comprehension may enable signers to integrate linguistic and nonlinguistic information within the visual modality. In two eye-tracking experiments, we investigated American Sign language (ASL) semantic prediction in deaf adults and children (aged 4\textendash 8 years). Participants viewed ASL sentences in a visual world paradigm in which the sentence-initial verb was either neutral or constrained relative to the sentence-final target noun. Adults and children made anticipatory looks to the target picture before the onset of the target noun in the constrained condition only, showing evidence for semantic prediction. Crucially, signers alternated gaze between the stimulus sign and the target picture only when the sentential object could be predicted from the verb. Signers therefore engage in prediction by optimising visual attention between divided linguistic and referential signals. These patterns suggest that prediction is a modality-independent process, and theoretical implications are discussed.},
  langid = {english},
  keywords = {audiovisual,audiovisual vwp,prediction,semantic prediction,sign language,signing,vwp}
}

@article{liHumanCorticalEncoding2021,
  title = {Human Cortical Encoding of Pitch in Tonal and Non-Tonal Languages},
  author = {Li, Yuanning and Tang, Claire and Lu, Junfeng and Wu, Jinsong and Chang, Edward F.},
  year = {2021},
  month = feb,
  journal = {Nature Communications},
  volume = {12},
  number = {1},
  pages = {1161},
  publisher = {{Nature Publishing Group}},
  issn = {2041-1723},
  doi = {10.1038/s41467-021-21430-x},
  urldate = {2021-03-02},
  abstract = {Languages can use a common repertoire of vocal sounds to signify distinct meanings. In tonal languages, such as Mandarin Chinese, pitch contours of syllables distinguish one word from another, whereas in non-tonal languages, such as English, pitch is used to convey intonation. The neural computations underlying language specialization in speech perception are unknown. Here, we use a cross-linguistic approach to address this. Native Mandarin- and English- speaking participants each listened to both Mandarin and English speech, while neural activity was directly recorded from the non-primary auditory cortex. Both groups show language-general coding of speaker-invariant pitch at the single electrode level. At the electrode population level, we find language-specific distribution of cortical tuning parameters in Mandarin speakers only, with enhanced sensitivity to Mandarin tone categories. Our results show that speech perception relies upon a shared cortical auditory feature processing mechanism, which may be tuned to the statistics of a given language.},
  copyright = {2021 The Author(s)},
  langid = {english},
  keywords = {ecog,f0,intonation,mandarin,normalization,pitch,prosody,specnorm,tone}
}

