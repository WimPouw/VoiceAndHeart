@article{samuelLexicalRepresentationsAre2016,
  title = {Lexical Representations Are Malleable for about One Second: {{Evidence}} for the Non-Automaticity of Perceptual Recalibration},
  shorttitle = {Lexical Representations Are Malleable for about One Second},
  author = {Samuel, Arthur G.},
  year = {2016},
  month = aug,
  journal = {Cognitive Psychology},
  volume = {88},
  pages = {88--114},
  issn = {0010-0285},
  doi = {10.1016/j.cogpsych.2016.06.007},
  urldate = {2019-01-29},
  abstract = {In listening to speech, people have been shown to apply several types of adjustment to their phonemic categories that take into account variations in the prevailing linguistic environment. These adjustments include selective adaptation, lexically driven recalibration, and audiovisually determined recalibration. Prior studies have used dual task procedures to test whether these adjustments are automatic or if they require attention, and all of these tests have supported automaticity. The current study instead uses a method of targeted distraction to demonstrate that lexical recalibration does in fact require attention. Building on this finding, the targeted distraction method is used to measure the period of time during which the lexical percept remains malleable. The results support a processing window of approximately one second, consistent with the results of a small number of prior studies that bear on this question. The results also demonstrate that recalibration is closely linked to the completion of lexical access.},
  keywords = {attention,Attention in recalibration,cognitive load,distraction,Lexical processing time,perceptual learning,Perceptual recalibration,recalibration,selective attention}
}

