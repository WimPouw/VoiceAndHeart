  abstract = {Our eyes constantly follow objects we see, but do they also move in synchrony with auditory inputs? Here, the authors show that eyelid movements track the temporal structure of speech and other sound sequences, which could reflect a role of motor systems in temporal attention and sequence processing.},
  copyright = {2018 The Author(s)},
  langid = {english},
