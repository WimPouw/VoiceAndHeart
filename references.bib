@article{kutscheidHowPriorExperience2021,
  title = {How Prior Experience with Pitch Accents Shapes the Perception of Word and Sentence Stress},
  author = {Kutscheid, Sophie and {Zahner-Ritter}, Katharina and Leemann, Adrian and Braun, Bettina},
  year = {2021},
  month = jun,
  journal = {Language, Cognition and Neuroscience},
  volume = {0},
  number = {0},
  pages = {1--17},
  publisher = {{Routledge}},
  issn = {2327-3798},
  doi = {10.1080/23273798.2021.1946109},
  urldate = {2021-07-05},
  abstract = {Listeners perceive high or rising pitch as stressed \textendash{} at the word and sentence level (high-pitch bias). Since stressed syllables can also be low-pitched, this bias may lead to misinterpretations of word and sentence stress and thus slow down speech comprehension. We investigate the effect of immediate exposure with high- vs. low-pitched stressed syllables on the identification of word and sentence stress. Participants were exposed to utterances containing only high- vs. low-pitched stressed syllables. In experimental trials, they then heard either trisyllabic words with word stress on the second syllable (Experiment 1) or three-word-sentences with sentence stress on the second word (Experiment 2) and indicated the position of word/sentence stress. Stimuli were presented in three intonation conditions (high-pitched first, second, or third syllable/word). Both experiments endorsed the high-pitch bias, with an increase after high-pitch exposure. Our results suggest a speaker-independent re-weighting of acoustic cues to stress, which is driven by experience.},
  keywords = {abstraction,distributional learning,Experience,exposure,generalization,German,high pitch,intonation,lexical stress,low pitch,perceptual learning,pitch,processing mechanism,retuning,sentence accent,sentence stress,stress,stress perception,talker-specificity,word stress}
}

