  publisher = {{National Academy of Sciences}},
  issn = {0027-8424, 1091-6490},
  doi = {10.1073/pnas.1721165115},
  urldate = {2020-07-22},
  abstract = {Two primary goals of psychological science should be to understand what aspects of human psychology are universal and the way that context and culture produce variability. This requires that we take into account the importance of culture and context in the way that we write our papers and in the types of populations that we sample. However, most research published in our leading journals has relied on sampling WEIRD (Western, educated, industrialized, rich, and democratic) populations. One might expect that our scholarly work and editorial choices would by now reflect the knowledge that Western populations may not be representative of humans generally with respect to any given psychological phenomenon. However, as we show here, almost all research published by one of our leading journals, Psychological Science, relies on Western samples and uses these data in an unreflective way to make inferences about humans in general. To take us forward, we offer a set of concrete proposals for authors, journal editors, and reviewers that may lead to a psychological science that is more representative of the human condition.},
  chapter = {Colloquium Paper},
  copyright = {\textcopyright{} 2018 . http://www.pnas.org/site/aboutpnas/licenses.xhtmlPublished under the PNAS license.},
  langid = {english},
  pmid = {30397114},
  keywords = {cognition,culture,diversity,methodology,psychological science},
  file = {C\:\\Users\\wimpo\\Zotero\\storage\\II43ZVXL\\Rad et al. - 2018 - Toward a psychology of Homo sapiens Making psycho.pdf;C\:\\Users\\wimpo\\Zotero\\storage\\M2BNWVF5\\11401.html}
}

@article{raemaekersLoudCallsGibbon1984,
  title = {Loud {{Calls}} of the {{Gibbon}} ({{Hylobates}} Lar): {{Repertoire}}, {{Organisation}} and {{Context}}},
  shorttitle = {Loud {{Calls}} of the {{Gibbon}} ({{Hylobates}} Lar)},
  author = {Raemaekers, Jeremy J. and Raemaekers, Patricia M. and Haimoff, Elliott H.},
  year = {1984},
  journal = {Behaviour},
  volume = {91},
  number = {1/3},
  eprint = {4534384},
  eprinttype = {jstor},
  pages = {146--189},
  publisher = {{Brill}},
  issn = {0005-7959},
  urldate = {2023-01-30},
  abstract = {We describe and illustrate with sonograms the loud calls of a monogamous, territorial ape, the lar gibbon (Hylobates lar). We attempt an overview of its repertoire of loud calls, their orgnisation, contexts and functions. The description is based on a two year study of a wild population in Khao Yai National Park, Thailand. We distinguish seven classes of call bout: male solo, male dispute calls, female solo, normal duet by bonded pair, ooaa duet (similar to normal duet, but more infectious to other groups), disturbed calls and contact calls. The organisation of the normal duet is described in detail, showing the coordination of the sexes, the development of the male part through the call bout, and the presence of individual and pair differences. The discussion considers the possible functions of duets, of male solos, and of disturbed calls given in reaction to man. /// Nous d\'ecrivons, avec illustration par des sonogrammes, les chants du Gibbon lar (Hylobates lar), singe monogame et territorial. Notre but est une \'etude g\'en\'erale de son r\'epertoire de chants, de leur organisation, des circonstances de leur \'emission et de leurs fonctions biologiques. Nous nous appuyons sur l'\'etude dans la nature, durant deux ans, d'une population sauvage habitant le Parc national de Khao Yai, en Tha\"ilande. Nous distinguons sept classes de chants, \`a savoir: solo du m\^ale, chant m\^ale de contestation territoriale, solo de la femelle, duo normal d'un couple \'etabli, duo ooaa (semblable au pr\'ec\'edent, mais se transmettant davantage aux autres groupes), chant d'inqui\'etude, et chant de rassemblement. Nous d\'ecrivons en d\'etail l'organisation du duo, montrant la coordination entre les 2 sexes, l'\'elaboration de la partie m\^ale au cours du chant, et l'existence de diff\'erences entre les individus et entre les couples. Dans la discussion, nous examinons les fonctions biologiques \'eventuelles du duo, du solo m\^ale, et des chants d'inqui\'etude d\'eclench\'es par la pr\'esence humaine.}
}

