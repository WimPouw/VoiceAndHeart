@article{newmanTemporalDistanceCrossvoiceinprep.,
  title = {Temporal Distance and Cross-Voice Rate Normalization},
  author = {Newman, Rochelle S. and Sawusch, James R.},
  year = {in prep.},
  abstract = {Individuals vary the rate at which they speak, and listeners use the speaking rate of precursor sentences to adjust for these changes (Kidd, 1989).  When one speaker begins talking soon after another ends, listeners may use the speaking rate of the first voice's sentence to adjust their perception of the second voice.  The present paper examines the time-course of such cross-voice normalization through a series of 6 experiments, each involving a male precursor phrase followed by a target word in a female voice.  When the target word was immediately adjacent to the male talker voice, listeners used rate information in the male voice to help them interpret the succeeding (female) speech.  The speaking rate of the male voice continued to have an effect when intervening speech in the female voice was inserted, as long as the female target word was within 1 second of the end of the male phrase.  When the male voice and the female target word were separated by either 1 second of silence, or 1 second of intervening female speech, the rate normalization effect disappeared. These results suggest that there is a temporal window for precursor speaking rate normalization that is approximately 1 second in length, and any information that falls within that window (including speech from another talker) influences the process of rate normalization.},
  keywords = {crosstalker,crossvoice,distal,distance,preprint,ratenorm,silence,talker switch,time course,vot}
}

@article{ngBody2HandsLearningInfer2020,
  title = {{{Body2Hands}}: {{Learning}} to {{Infer 3D Hands}} from {{Conversational Gesture Body Dynamics}}},
