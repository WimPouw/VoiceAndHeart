@article{wagnerGestureSpeechInteraction2014,
  title = {Gesture and Speech in Interaction: {{An}} Overview},
  shorttitle = {Gesture and Speech in Interaction},
  author = {Wagner, Petra and Malisz, Zofia and Kopp, Stefan},
