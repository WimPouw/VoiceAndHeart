  title = {Postural Activity of the Diaphragm Is Reduced in Humans When Respiratory Demand Increases},
  author = {Hodges, P. W and Heijnen, I. and Gandevia, S. C},
  year = {2001},
  month = dec,
  journal = {The Journal of Physiology},
  volume = {537},
  number = {3},
