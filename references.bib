}

@article{hostetterGestureSimulatedAction2019,
  title = {Gesture as Simulated Action: {{Revisiting}} the Framework},
  shorttitle = {Gesture as Simulated Action},
  author = {Hostetter, Autumn B. and Alibali, Martha W.},
  year = {2019},
