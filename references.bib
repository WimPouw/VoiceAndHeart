@article{yanUnexpectedComplexityEveryday2020,
  title = {Unexpected Complexity of Everyday Manual Behaviors},
  author = {Yan, Yuke and Goodman, James M. and Moore, Dalton D. and Solla, Sara A. and Bensmaia, Sliman J.},
  year = {2020},
