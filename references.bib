@article{petersPurringSimilarVocalizations2002,
  title = {Purring and Similar Vocalizations in Mammals},
  author = {Peters, G.},
  year = {2002},
  journal = {Mammal Review},
  volume = {32},
  number = {4},
  pages = {245--271},
  issn = {1365-2907},
  doi = {10.1046/j.1365-2907.2002.00113.x},
  urldate = {2021-03-26},
  abstract = {The terms purr and purring have been used for vocalizations produced by a variety of mammalian species in different orders. A few other mammalian vocalizations that are structurally somewhat similar to felid purring but have been given another term have also been described in the literature. Because use of the same term implies `sameness', which in an evolutionary sense can only mean that the vocalizations so named are homologous (= share the same ancestral vocalization type), the terms purr and purring ought to be restricted to vocalizations homologous with felid purring, and any mammalian vocalization homologous with felid purring ought to be named accordingly. According to present knowledge `true' purring is established only in the families Viverridae and Felidae of the Carnivora. Vocalizations very similar in structure occur in matching behavioural contexts in other families of the Carnivora and several other mammalian orders. Most of these vocalization types are likely to have evolved convergently.},
  langid = {english},
  keywords = {convergent evolution,homology,mammal vocalization,purr,purring},
  file = {C\:\\Users\\wimpo\\Zotero\\storage\\QDTS3LF3\\j.1365-2907.2002.00113.html}
}

