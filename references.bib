@article{benitezTwoPriceOne2021,
  title = {Two for the Price of One: {{Concurrent}} Learning of Words and Phonotactic Regularities from Continuous Speech},
  shorttitle = {Two for the Price of One},
  author = {Benitez, Viridiana L. and Saffran, Jenny R.},
