@article{navarraAssessingRoleAttention2010,
  title = {Assessing the Role of Attention in the Audiovisual Integration of Speech},
  author = {Navarra, Jordi and Alsius, Agn{\`e}s and {Soto-Faraco}, Salvador and Spence, Charles},
  year = {2010},
