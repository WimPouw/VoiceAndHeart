@inproceedings{dilleySlowJoeFast2017,
  title = {Slow {{Joe}} and {{Fast Mary}}: {{Statistical Learning}} of {{Talker Rate Influences Word Perception}}},
  shorttitle = {({{PDF}}) {{Slow Joe}} and {{Fast Mary}}},
  booktitle = {The 30th {{CUNY Conference}} on {{Human Sentence Processing}}},
  author = {Dilley, Laura C. and Ireland, Zachary and Viswanathan, Navin and Sanders, Lisa and Arjmandi, Meisam K. and Wieland, Liz},
  year = {2017},
  address = {{Boston, MA}},
  urldate = {2019-06-12},
  abstract = {Sensitivity to timing between speech events is crucial for understanding language. Recently, we demonstrated that listeners track speech rate statistics over an extended timescale (\textasciitilde 1 hour), where this influences perceptions of words and word boundaries in reduced speech (e.g., or spoken as "errr" in leisure or time) (Baese-Berk, Heffner, et al., 2014). However, it is not clear if listeners track aggregate speech rate statistics experienced across talkers, or whether statistical learning of speech rate is conditioned on experience with individual talkers or talker groups. To test these possibilities, an experiment was conducted in which two talkers (one male, one female) who frequently coarticulated and reduced words were selected from a corpus of sentences which contained a critical function word (e.g., or in Deena didn't have any leisure or time). The sentences were grammatically compatible with the critical function word being present or absent. Each talker produced 100 sentences in a memory task expected to elicit casual speech. Of the 100 sentences, 36 were assigned to the test set and the remaining 64 sentences were assigned to the training set. The dependent variable was the proportion of critical function words transcribed by N = 24 college-age adults in a free transcription task. To create test materials, one production of each of the 36 sentences was selected (18 per talker). Each selected sentence was manipulated so the distal speech rate (e.g., across Deena didn't have any lei-) was 1.3 or 1.6 times its original duration, values expected to yield proportions of critical function words greater than or less than 50\%, respectively. To create training materials, each of the remaining 64 sentences spoken by each talker was manipulated so the distal speech had a duration equal to (i.e., 1.0 times) that of the original speech ("fast" speech) or 1.9 times that of the original speech ("slow" speech). We hypothesized listeners would learn the statistics of speech rates of talkers during training in a manner that would influence word perception for test items. Four training lists were constructed by counterbalancing pairings of distal speech rate and talker with each training sentence, yielding two Training conditions (collapsing across item pairings): Female Fast/Male Slow and Male Fast/Female Slow. Prior studies established that: (1) slowing the "distal" speech rate while holding constant acoustic properties of "target" speech containing the critical word (e.g.,-sure or time) causes listeners to fail to hear that word (the "disappearing word effect"); and (2) within limits, the slower the distal speech rate, the smaller the proportion of critical function words that listeners report. Participants were randomly assigned in equal numbers to the four lists and exposed to training sentences two times in random order, blocking by repetition. Responses were analyzed in three-way ANOVAs by-subjects and by-items with within-subjects factors of Test Distal Rate and Test Talker and a between-subjects factor of Training. Crucially, as predicted, we found a significant Training x Test Talker interaction. Also, we found significant by-subjects main effects for Test Talker and Test Distal Rate, and a significant interaction between Test Talker and Test Distal Rate, but effects were not significant by-items. Other main effects and interactions were not significant. The results provide support for a Bayesian, predictive coding view of speech perception (Tavano \& Scharinger, 2015; Norris, McQueen, \& Cutler, 2016) according to which listeners predict and cognitively recapitulate interpretations of speech which are maximally consistent with the input. These data support the notion that the predictive process includes determination of a talker's likely identity and/or group membership in order to apply relevant statistics based on prior experiences to "normalize" for talker variation during spoken language processing and determine probable speaker intentions.},
  langid = {english},
  keywords = {distal,dwe,global,lre,ratenorm,talker-specific}
}

