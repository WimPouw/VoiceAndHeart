  author = {Hewes, Gordon W. and Andrew, R. J. and Carini, Louis and Choe, Hackeny and Gardner, R. Allen and Kortlandt, A. and Krantz, Grover S. and McBride, Glen and Nottebohm, Fernando and Pfeiffer, John and Rumbaugh, Duane G. and Steklis, Horst D. and Raliegh, Michael J. and Stopa, Roman and Suzuki, Akira and Washburn, S. L. and Wescott, Roger W.},
