@article{novackActionAbstractionUsing2014,
  title = {From {{Action}} to {{Abstraction}}: {{Using}} the {{Hands}} to {{Learn Math}}},
  shorttitle = {From {{Action}} to {{Abstraction}}},
  author = {Novack, Miriam A. and Congdon, Eliza L. and {Hemani-Lopez}, Naureen and {Goldin-Meadow}, Susan},
  year = {2014},
  month = apr,
  journal = {Psychological Science},
  volume = {25},
  number = {4},
  pages = {903--910},
  publisher = {{SAGE Publications Inc}},
  issn = {0956-7976},
  doi = {10.1177/0956797613518351},
  urldate = {2021-05-14},
  abstract = {Previous research has shown that children benefit from gesturing during math instruction. We asked whether gesturing promotes learning because it is itself a physical action, or because it uses physical action to represent abstract ideas. To address this question, we taught third-grade children a strategy for solving mathematical-equivalence problems that was instantiated in one of three ways: (a) in a physical action children performed on objects, (b) in a concrete gesture miming that action, or (c) in an abstract gesture. All three types of hand movements helped children learn how to solve the problems on which they were trained. However, only gesture led to success on problems that required generalizing the knowledge gained. The results provide the first evidence that gesture promotes transfer of knowledge better than direct action on objects and suggest that the beneficial effects gesture has on learning may reside in the features that differentiate it from action.},
  langid = {english},
  keywords = {cognitive development,gestures,learning},
  file = {C\:\\Users\\wimpo\\Zotero\\storage\\2CR379YN\\Novack et al. - 2014 - From Action to Abstraction Using the Hands to Lea.pdf}
}

