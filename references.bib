@article{panWhyHowUse2018,
  title = {Why and How to Use Virtual Reality to Study Human Social Interaction: {{The}} Challenges of Exploring a New Research Landscape},
  shorttitle = {Why and How to Use Virtual Reality to Study Human Social Interaction},
  author = {Pan, Xueni and Hamilton, Antonia F. de C.},
  year = {2018},
  journal = {British Journal of Psychology},
  volume = {109},
  number = {3},
  pages = {395--417},
  issn = {2044-8295},
  doi = {10.1111/bjop.12290},
  urldate = {2019-10-03},
  abstract = {As virtual reality (VR) technology and systems become more commercially available and accessible, more and more psychologists are starting to integrate VR as part of their methods. This approach offers major advantages in experimental control, reproducibility, and ecological validity, but also has limitations and hidden pitfalls which may distract the novice user. This study aimed to guide the psychologist into the novel world of VR, reviewing available instrumentation and mapping the landscape of possible systems. We use examples of state-of-the-art research to describe challenges which research is now solving, including embodiment, uncanny valley, simulation sickness, presence, ethics, and experimental design. Finally, we propose that the biggest challenge for the field would be to build a fully interactive virtual human who can pass a VR Turing test \textendash{} and that this could only be achieved if psychologists, VR technologists, and AI researchers work together.},
  copyright = {\textcopyright{} 2018 The Authors British Journal of Psychology published by John Wiley \& Sons Ltd on behalf of British Psychological Society},
  langid = {english},
  keywords = {avatars,psychology,social interaction,virtual humans,virtual reality,vr}
}

@book{paoloLinguisticBodiesContinuity2018,
  title = {Linguistic {{Bodies}}: {{The Continuity}} between {{Life}} and {{Language}}},
  shorttitle = {Linguistic {{Bodies}}},
  author = {Paolo, Ezequiel A. Di and Cuffari, Elena Clare and Jaegher, Hanne De},
  year = {2018},
  month = nov,
  publisher = {{MIT Press}},
  abstract = {A novel theoretical framework for an embodied, non-representational approach to language that extends and deepens enactive theory, bridging the gap between sensorimotor skills and language.Linguistic Bodies offers a fully embodied and fully social treatment of human language without positing mental representations. The authors present the first coherent, overarching theory that connects dynamical explanations of action and perception with language. Arguing from the assumption of a deep continuity between life and mind, they show that this continuity extends to language. Expanding and deepening enactive theory, they offer a constitutive account of language and the co-emergent phenomena of personhood, reflexivity, social normativity, and ideality. Language, they argue, is not something we add to a range of existing cognitive capacities but a new way of being embodied. Each of us is a linguistic body in a community of other linguistic bodies. The book describes three distinct yet entangled kinds of human embodiment, organic, sensorimotor, and intersubjective; it traces the emergence of linguistic sensitivities and introduces the novel concept of linguistic bodies; and it explores the implications of living as linguistic bodies in perpetual becoming, applying the concept of linguistic bodies to questions of language acquisition, parenting, autism, grammar, symbol, narrative, and gesture, and to such ethical concerns as microaggression, institutional speech, and pedagogy.},
  isbn = {978-0-262-03816-4},
  langid = {english},
  keywords = {Language Arts \& Disciplines / Linguistics / General,Psychology / Cognitive Psychology \& Cognition}
}

@article{paparrizosKShapeEfficientAccurate2016,
  title = {K-{{Shape}}: {{Efficient}} and {{Accurate Clustering}} of {{Time Series}}},
  shorttitle = {K-{{Shape}}},
  author = {Paparrizos, John and Gravano, Luis},
  year = {2016},
  month = jun,
  journal = {ACM SIGMOD Record},
  volume = {45},
  number = {1},
  pages = {69--76},
  issn = {0163-5808},
  doi = {10.1145/2949741.2949758},
  urldate = {2022-04-26},
  abstract = {The proliferation and ubiquity of temporal data across many disciplines has generated substantial interest in the analysis and mining of time series. Clustering is one of the most popular data mining methods, not only due to its exploratory power, but also as a preprocessing step or subroutine for other techniques. In this paper, we describe k-Shape, a novel algorithm for time-series clustering. k-Shape relies on a scalable iterative refinement procedure, which creates homogeneous and well-separated clusters. As its distance measure, k-Shape uses a normalized version of the cross-correlation measure in order to consider the shapes of time series while comparing them. Based on the properties of that distance measure, we develop a method to compute cluster centroids, which are used in every iteration to update the assignment of time series to clusters. An extensive experimental evaluation against partitional, hierarchical, and spectral clustering methods, with the most competitive distance measures, showed the robustness of k-Shape. Overall, k-Shape emerges as a domain-independent, highly accurate, and efficient clustering approach for time series with broad applications.}
}

