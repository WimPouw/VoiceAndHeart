  abstract = {Cavities branching off the main vocal tract are ubiquitous in nonhumans. Mammalian air sacs exist in human relatives, including all four great apes, but only a substantially reduced version exists in humans. The present paper focuses on acoustical functions of the air sacs. The hypotheses are investigated on whether the air sacs affect amplitude of utterances and/or position of formants. A multilayer synthetic model of the vocal folds coupled with a vocal tract model was utilized. As an air sac model, four configurations were considered: open and closed uniform tube-like side branches, a rigid cavity, and an inflatable cavity. Results suggest that some air sac configurations can enhance the sound level. Furthermore, an air sac model introduces one or more additional resonance frequencies, shifting formants of the main vocal tract to some extent but not as strongly as previously suggested. In addition, dynamic range of vocalization can be extended by the air sacs. A new finding is also an increased variability of the vocal tract impedance, leading to strong nonlinear source-filter interaction effects. The experiments demonstrated that air-sac-like structures can destabilize the sound source. The results were validated by a transmission line computational model.},
  langid = {english},
  pmcid = {PMC2677336},
  pmid = {18647005},
  keywords = {Acoustic Impedance Tests,Air,Animals,Larynx,Mammals,Sound Spectrography,Vibration,Vocal Cords},
  file = {C\:\\Users\\wimpo\\Zotero\\storage\\FIBAMHKI\\Riede et al. - 2008 - Mammalian laryngseal air sacs add variability to t.pdf}
}

@article{riedePygmyMouseSongs2020,
  title = {Pygmy Mouse Songs Reveal Anatomical Innovations Underlying Acoustic Signal Elaboration in Rodents},
  author = {Riede, Tobias and Pasch, Bret},
  year = {2020},
  month = jun,
  journal = {Journal of Experimental Biology},
  volume = {223},
  number = {12},
  pages = {jeb223925},
  issn = {0022-0949},
  doi = {10.1242/jeb.223925},
  urldate = {2022-01-17},
  abstract = {Elaborate animal communication displays are often accompanied by morphological and physiological innovations. In rodents, acoustic signals used in reproductive contexts are produced by two distinct mechanisms, but the underlying anatomy that facilitates such divergence is poorly understood. `Audible' vocalizations with spectral properties between 500\hspace{0.25em}Hz and 16\hspace{0.25em}kHz are thought to be produced by flow-induced vocal fold vibrations, whereas `ultrasonic' vocalizations with fundamental frequencies above 19\hspace{0.25em}kHz are produced by an aerodynamic whistle mechanism. Baiomyine mice (genus Baiomys and Scotinomys) produce complex frequency-modulated songs that span these traditional distinctions and represent important models to understand the evolution of signal elaboration. We combined acoustic analyses of spontaneously vocalizing northern pygmy mice (Baiomys\hphantom{,}taylori) in air and light gas atmosphere with morphometric analyses of their vocal apparatus to infer the mechanism of vocal production. Increased fundamental frequencies in heliox indicated that pygmy mouse songs are produced by an aerodynamic whistle mechanism supported by the presence of a ventral pouch and alar cartilage. Comparative analyses of the larynx and ventral pouch size among four additional ultrasonic whistle-producing rodents indicated that the unusually low `ultrasonic' frequencies (relative to body size) of pygmy mice songs are associated with an enlarged ventral pouch. Additionally, mice produced shorter syllables while maintaining intersyllable interval duration, thereby increasing syllable repetition rates. We conclude that while laryngeal anatomy sets the foundation for vocal frequency range, variation and adjustment of central vocal motor control programs fine tunes spectral and temporal characters to promote acoustic diversity within and between species.},
  file = {C\:\\Users\\wimpo\\Zotero\\storage\\6KMRNXN4\\Riede and Pasch - 2020 - Pygmy mouse songs reveal anatomical innovations un.pdf;C\:\\Users\\wimpo\\Zotero\\storage\\WN8KGRM2\\Pygmy-mouse-songs-reveal-anatomical-innovations.html}
}

