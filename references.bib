@article{tempradoDynamicPatternAnalysis2002,
  title = {A Dynamic Pattern Analysis of Coordination between Breathing and Rhythmic Arm Movements in Humans},
  author = {Temprado, J. J. and Milliex, L. and Gr{\'e}lot, L. and Coyle, T. and Calvin, S. and Laurent, M.},
  year = {2002},
  month = sep,
  journal = {Neuroscience Letters},
  volume = {329},
  number = {3},
  pages = {314--318},
  issn = {0304-3940},
  doi = {10.1016/S0304-3940(02)00455-X},
  urldate = {2020-09-01},
  abstract = {We investigated the behavioral dynamics of human breathing\textendash wrist movement coordination in a 1:1 frequency locking task. A pronation\textendash supination wrist movement and a short trial duration were chosen to limit both mechanical and metabolic constraints on the respiratory system. Subjects voluntarily controlled their breathing rhythm to follow the metronome. We found that pronation\textendash expiration and pronation\textendash inspiration patterns coexisted as the (sole) stable fixed-point attractors of the coordination system. The pronation\textendash expiration pattern was more stable than the pronation\textendash inspiration pattern. Depending on the oscillation frequency, this differential stability gave rise to both absolute and relative coordination. These results show that simple behavioral laws of coordination encapsulate neural coupling dynamics evidenced from experimental research in human beings and animals. They challenge the classical view that such a coupling is not present for all imposed movement frequencies. Rather, relative coordination emerges as a result of the modification of coupling strength with frequency. These results can be accommodated by the asymmetric version of the HKB model of coordination dynamics. Thus, our data suggest that the principles and models of coordination dynamics may be taken as a reference to study the coupling of the motor and physiological subsystems involved in breathing\textendash movement coordination.},
  langid = {english},
  keywords = {Breathing,Coordination,Coupled oscillators,Dynamical systems,Intermittent dynamics},
  file = {C\:\\Users\\wimpo\\Zotero\\storage\\PLF3YN3A\\S030439400200455X.html}
}

