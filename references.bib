  volume = {44},
  number = {6},
  pages = {914--924},
  issn = {1939-1277, 0096-1523},
  doi = {10.1037/xhp0000504},
  urldate = {2018-07-24},
  abstract = {Speech perception is highly context dependent. This study compares the strength of contextual influences in the perception of lexical tone and vowel quality in a number of ways. Perception of lexical tone was found to be influenced by locally preceding and following contexts, while vowel quality was only influenced by the preceding context, and that influence extended further back in time. These patterns demonstrate that the temporal scope of contextual influences are cue specific.},
  langid = {english},
  keywords = {cantonese,following context,lexical tone,pitch,specnorm,tone}
}

@article{sjerpsListeningDifferentSpeakers2011,
  title = {Listening to Different Speakers: {{On}} the Time-Course of Perceptual Compensation for Vocal-Tract Characteristics},
  shorttitle = {Listening to Different Speakers},
  author = {Sjerps, Matthias J. and Mitterer, Holger and McQueen, James M.},
  year = {2011},
  month = dec,
  journal = {Neuropsychologia},
  volume = {49},
  number = {14},
  pages = {3831--3846},
  issn = {0028-3932},
  doi = {10.1016/j.neuropsychologia.2011.09.044},
  urldate = {2018-07-24},
  abstract = {This study used an active multiple-deviant oddball design to investigate the time-course of normalization processes that help listeners deal with between-speaker variability. Electroencephalograms were recorded while Dutch listeners heard sequences of non-words (standards and occasional deviants). Deviants were [ipapu] or [{$\varepsilon$}papu], and the standard was [I{$\varepsilon$}papu], where [I{$\varepsilon$}] was a vowel that was ambiguous between [{$\varepsilon$}] and [i]. These sequences were presented in two conditions, which differed with respect to the vocal-tract characteristics (i.e., the average 1st formant frequency) of the [papu] part, but not of the initial vowels [i], [{$\varepsilon$}] or [I{$\varepsilon$}] (these vowels were thus identical across conditions). Listeners more often detected a shift from [I{$\varepsilon$}papu] to [{$\varepsilon$}papu] than from [I{$\varepsilon$}papu] to [ipapu] in the high F1 context condition; the reverse was true in the low F1 context condition. This shows that listeners' perception of vowels differs depending on the speaker's vocal-tract characteristics, as revealed in the speech surrounding those vowels. Cortical electrophysiological responses reflected this normalization process as early as about 120ms after vowel onset, which suggests that shifts in perception precede influences due to conscious biases or decision strategies. Listeners' abilities to normalize for speaker-vocal-tract properties are for an important part the result of a process that influences representations of speech sounds early in the speech processing stream.},
  keywords = {eeg,Event-related potential (ERP),N1,specnorm,Speech perception,Vowel normalization}
}

