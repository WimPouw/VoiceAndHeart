@article{currieEcholocationHighIntensity2020,
  title = {Echolocation at High Intensity Imposes Metabolic Costs on Flying Bats},
  author = {Currie, Shannon E. and Boonman, Arjan and Troxell, Sara and Yovel, Yossi and Voigt, Christian C.},
  year = {2020},
