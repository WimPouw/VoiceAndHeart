@article{leroiRevolutions2020,
  title = {On Revolutions},
  author = {Leroi, Armand M. and Lambert, Ben and Mauch, Matthias and Papadopoulou, Marina and Ananiadou, Sophia and Lindberg, Staffan I. and Lindenfors, Patrik},
  year = {2020},
