@article{boddaertPerceptionComplexSounds2003,
  title = {Perception of {{Complex Sounds}}: {{Abnormal Pattern}} of {{Cortical Activation}} in {{Autism}}},
  shorttitle = {Perception of {{Complex Sounds}}},
  author = {Boddaert, N. and Belin, Pascal and Chabane, Nadia and Poline, Jean-Baptiste and Barth{\'e}l{\'e}my, Catherine and {Mouren-Simeoni}, Marie-Christine and Brunelle, Francis and Samson, Yves and Zilbovicius, M{\^o}nica},
  year = {2003},
  month = nov,
  journal = {American Journal of Psychiatry},
  volume = {160},
  number = {11},
  pages = {2057--2060},
  publisher = {{American Psychiatric Publishing}},
  issn = {0002-953X},
  doi = {10.1176/appi.ajp.160.11.2057},
  urldate = {2021-02-23},
  abstract = {OBJECTIVE: Bilateral temporal hypoperfusion at rest was recently described in autism. In normal adults, these regions are activated by listening to speech-like sounds. To investigate auditory cortical processing in autism, the authors performed a positron emission tomography activation study. METHOD: Regional cerebral blood flow was measured in five autistic adults and eight comparison subjects during rest and while listening to speech-like sounds. RESULTS: Similar to the comparison subjects, autistic patients showed a bilateral activation of the superior temporal gyrus. However, an abnormal pattern of hemispheric activation was observed in the autistic group. The volume of activation was larger on the right side in the autistic patients, whereas the reverse pattern was found in the comparison group. The direct comparison between the two groups showed that the right middle frontal gyrus exhibited significantly greater activation in the autistic group. Conversely, the left temporal areas exhibited lessactivation in autistic patients. CONCLUSIONS: These findings suggest that abnormal auditory cortical processing is implicated in the language impairments and the inadequate response to sounds typically seen in autism.},
  keywords = {audiovisual,auditory,autism,integration,multisensory,psts,sts}
}

@article{boddaertSuperiorTemporalSulcus2004,
  title = {Superior Temporal Sulcus Anatomical Abnormalities in Childhood Autism: A Voxel-Based Morphometry {{MRI}} Study},
  shorttitle = {Superior Temporal Sulcus Anatomical Abnormalities in Childhood Autism},
  author = {Boddaert, N. and Chabane, N. and Gervais, H. and Good, C. D. and Bourgeois, M. and Plumet, M-H. and Barth{\'e}l{\'e}my, C. and Mouren, M-C. and Artiges, E. and Samson, Y. and Brunelle, F. and Frackowiak, R. S. J. and Zilbovicius, M.},
  year = {2004},
  month = sep,
  journal = {NeuroImage},
  volume = {23},
  number = {1},
  pages = {364--369},
  issn = {1053-8119},
  doi = {10.1016/j.neuroimage.2004.06.016},
  urldate = {2021-02-23},
  abstract = {The underlying neurobiology of autism, a severe pervasive developmental disorder, remains unknown. Few neocortical brain MRI abnormalities have been reported. Using rest functional brain imaging, two independent studies have described localized bilateral temporal hypoperfusion in children with primary autism. In order to search for convergent evidence of anatomical abnormalities in autistic children, we performed an anatomical MRI study using optimized whole-brain voxel-based morphometry (VBM). High-resolution 3-D T1-weighted MRI data sets were acquired in 21 children with primary autism (mean age 9.3 {$\pm$} 2.2 years) and 12 healthy control children (mean age 10.8 {$\pm$} 2.7 years). By comparing autistic children to normal children, we found bilaterally significant decreases of grey matter concentration located in superior temporal sulcus (STS) (P {$<$} 0.05 corrected, after small volume correction; SVC). Children with autism were also found to have a decrease of white matter concentration located in the right temporal pole and in cerebellum (P {$<$} 0.05, corrected) compared to normal children. These results suggest that autism is associated with bilateral anatomical abnormalities localized in the STS and are remarkably consistent with functional hypoperfusion previously reported in children with autism. The multimodal STS areas are involved in highest level of cortical integration of both sensory and limbic information. Moreover, the STS is now recognized as a key cortical area of the ``social brain'' and is implicated in social perceptual skills that are characteristically impaired in autism. Therefore, the convergent anatomical and functional temporal abnormalities observed in autism may be important in the understanding of brain behavior relationships in this severe developmental disorder.},
  langid = {english},
  keywords = {anatomy,audiovisual,autism,Autism,integration,Morphometry,mri,psts,sts,Superior temporal sulcus}
}

