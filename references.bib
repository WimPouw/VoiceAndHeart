@article{pingetLinkingVariationPerception2020,
  title = {Linking {{Variation}} in {{Perception}} and {{Production}} in {{Sound Change}}: {{Evidence}} from {{Dutch Obstruent Devoicing}}},
  shorttitle = {Linking {{Variation}} in {{Perception}} and {{Production}} in {{Sound Change}}},
  author = {Pinget, Anne-France and Kager, Ren{\'e} and {Van de Velde}, Hans},
  year = {2020},
