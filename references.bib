  author = {Kotz, S. A. and Ravignani, A. and Fitch, W. T.},
  year = {2018},
  month = oct,
  journal = {Trends in Cognitive Sciences},
  series = {Special {{Issue}}: {{Time}} in the {{Brain}}},
