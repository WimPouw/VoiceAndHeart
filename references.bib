@article{teasdaleDeterminingMovementOnsets1993,
  title = {Determining {{Movement Onsets}} from {{Temporal Series}}},
  author = {Teasdale, Normand and Bard, Chantal and Fleury, Michelle and Young, Douglas E. and Proteau, Luc},
