  shorttitle = {Social Perceptual Function in {{Parkinson}}'s Disease},
  author = {Coundouris, Sarah P. and Adams, Alexandra G. and Grainger, Sarah A. and Henry, Julie D.},
  year = {2019},
  journal = {Neuroscience and Biobehavioral Reviews},
  volume = {104},
