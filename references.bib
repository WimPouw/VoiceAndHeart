@article{mustafaogluDoesSpeechDisorder2017,
  title = {Does {{Speech Disorder}} ({{Aphasia}}) {{Affect Respiratory Muscle Strength}} in {{Stroke}}?},
  author = {Mustafaoglu, Rustem and Yildiz, Abdurrahim and Bardak, Ay{\c s}e Nur},
  year = {2017},
  month = sep,
  journal = {European Respiratory Journal},
  volume = {50},
  number = {suppl 61},
  publisher = {{European Respiratory Society}},
  issn = {0903-1936, 1399-3003},
  doi = {10.1183/1393003.congress-2017.PA3699},
  urldate = {2021-09-17},
  abstract = {Background: Aphasia is one of the most common symptoms in acute and chronic stroke patients. During speech and voice production, there is a fine balancing act being performed by the lungs, rib cage, diaphragm, and associated muscles. This equilibrium must be sustained in order to generated and maintain a steady subglottal air pressure for speech and voice production. Respiratory functions and respiratory muscle strength decreases after stroke. It is not yet known whether speech impairment causes more impairment of respiratory muscle strength in stroke. Therefore, the aim of this study to investigate whether aphasia affect respiratory muscle strength. Methods: A total of 56 volunteer stroke patients (28 aphasic and 28 non-aphasic)were enrolled in this study. Respiratory muscle strengths (maximal inspiratory pressure (MIP); maximal expiratory pressure (MEP)) of the volunteers were evaluated by Carefusion Micro RPM device. Results: The mean age of subjects were 60.5{$\pm$}12.5 years. MIP and MEP values of aphasic stroke patients were;36.7{$\pm$}15.5 and 49.2{$\pm$}19.8(cmH2O), and non-aphasic stroke patients were; 47.1{$\pm$}18.5 and 52.1{$\pm$}25.6(cmH2O), respectively. Aphasic stroke patient's MIP score was statistically significantly lower than the non-aphasic stroke patients (p=0.02). Although, aphasic stroke patient's MEP score was found decreased compare to non-aphasic stroke patients, this decrease was not statistically significant (p=0.94). Conclusion: It is well known that respiratory muscle strength decrease in individuals after stroke. In addition, it seems that respiratory muscle strength of aphasic patients is significantly reduced compare to non-aphasic stroke patients. However, expiratory muscle strength is similar.},
  chapter = {Rehabilitation and Chronic Care},
  copyright = {Copyright \textcopyright the authors 2017},
  langid = {english},
  file = {C\:\\Users\\wimpo\\Zotero\\storage\\AFTMBBUN\\PA3699.html}
}

@article{muszVisualStatisticalLearning2015,
  title = {Visual Statistical Learning Is Not Reliably Modulated by Selective Attention to Isolated Events},
  author = {Musz, Elizabeth and Weber, Matthew J. and {Thompson-Schill}, Sharon L.},
  year = {2015},
  month = jan,
  journal = {Attention, Perception, \& Psychophysics},
  volume = {77},
  number = {1},
  pages = {78--96},
  issn = {1943-393X},
  doi = {10.3758/s13414-014-0757-5},
  urldate = {2019-04-01},
  abstract = {Recent studies of visual statistical learning (VSL) have indicated that the visual system can automatically extract the temporal and spatial relationships between objects. We report several attempts to replicate and extend earlier work (Journal of Experimental Psychology: General, 134, 552\textendash 564, 2005) in which observers performed a cover task on one of two interleaved stimulus sets, resulting in the learning of temporal relationships that occurred in the attended stream, but not those present in the unattended stream. Across four experiments, we exposed observers to similar or identical familiarization protocols, directing attention to one of two interleaved stimulus sets; afterward, we assessed the VSL efficacy for both sets using either implicit response time measures or explicit familiarity judgments. In line with prior work, we observed learning for the attended stimulus set. However, unlike in previous reports, we also observed learning for the unattended stimulus set. When instructed to selectively attend to only one of the stimulus sets and ignore the other set, observers could extract temporal regularities for both sets. Our efforts to experimentally decrease this effect by changing the cover task (Exp. 1) or the complexity of the statistical regularities (Exp. 3) were unsuccessful. A fourth experiment using a different assessment of learning likewise failed to show an attentional effect. Simulations drawing random samples from our first three experiments (n = 64) confirmed that the distribution of attentional effects in our sample closely approximated the null. We offer several potential explanations for our failure to replicate earlier findings and discuss how our results suggest limiting conditions on the relevance of attention to VSL.},
  langid = {english},
  keywords = {AGL,attention,Automaticity,cognitive load,distraction,distributional learning,explicit,implicit,Learning,selective attention,Selective attention,statistical learning}
}

