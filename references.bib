@article{kontraPhysicalExperienceEnhances2015,
  title = {Physical {{Experience Enhances Science Learning}}},
  author = {Kontra, Carly and Lyons, Daniel J. and Fischer, Susan M. and Beilock, Sian L.},
  year = {2015},
