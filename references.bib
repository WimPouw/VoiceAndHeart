  shorttitle = {Moving {{Fast}} and {{Slow}}},
  author = {Kucherenko, Taras and Hasegawa, Dai and Kaneko, Naoshi and Henter, Gustav Eje and Kjellstr{\"o}m, Hedvig},
  year = {2021},
  month = feb,
  journal = {International Journal of Human\textendash Computer Interaction},
