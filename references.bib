@article{blumbergRodentUltrasonicShort1992a,
  title = {Rodent Ultrasonic Short Calls: Locomotion, Biomechanics, and Communication},
  shorttitle = {Rodent Ultrasonic Short Calls},
  author = {Blumberg, M. S.},
  year = {1992},
  month = dec,
  journal = {Journal of Comparative Psychology (Washington, D.C.: 1983)},
  volume = {106},
  number = {4},
  pages = {360--365},
  issn = {0735-7036},
  doi = {10.1037/0735-7036.106.4.360},
  abstract = {Rodents of many species emit short ultrasonic vocalizations during copulation, aggression, and other activities. Thiessen and Kittrell (1979) hypothesized that ultrasound emission by gerbils is the acoustic by-product of physical compression of the thorax during certain locomotor behaviors. I carry this hypothesis further by relating gerbil ultrasound to the biomechanics of respiration during locomotion. I also suggest that at least some of the ultrasonic emissions of other rodent species are, like the gerbil's, by-products of thoracic compression during locomotion. Support for this suggestion comes from descriptions in the literature of ultrasound emission as well as slow-motion analysis of rat copulatory behavior. Finally, this alternative view of rodent ultrasound has consequences for the interpretation of experimental findings in ultrasound research and for the understanding of messages and meanings in rodent communication.},
  langid = {english},
  pmid = {1451418},
  keywords = {Animal Communication,Animals,Biomechanical Phenomena,Larynx,Locomotion,Rodentia,Species Specificity,Ultrasonics,{Vocalization, Animal}}
}

@article{blumbergUltrasonicVocalizationsRat1990,
  title = {Ultrasonic Vocalizations by Rat Pups in the Cold: {{An}} Acoustic by-Product of Laryngeal Braking?},
  shorttitle = {Ultrasonic Vocalizations by Rat Pups in the Cold},
  author = {Blumberg, Mark S. and Alberts, Jeffrey R.},
  year = {1990},
  journal = {Behavioral Neuroscience},
  volume = {104},
  number = {5},
  pages = {808--817},
  publisher = {{American Psychological Association}},
  address = {{US}},
  issn = {1939-0084},
  doi = {10.1037/0735-7044.104.5.808},
  abstract = {Isolated rat pups respond to cold exposure physiologically by increasing metabolic heat production and behaviorally by emitting ultrasound. The relationship between these 2 responses was investigated by monitoring oxygen consumption, heat production by brown adipose tissue, respiratory rate, and ultrasound production during cold exposure in pups 10\textendash 12 days of age. All 3 physiological measures increased contemporaneously with the initiation of ultrasound. Pups also exhibited a respiratory pattern characterized by the prolongation of expiratory duration in relation to inspiratory duration. Ultrasound was often detected during these prolonged expirations, suggesting that pups were using laryngeal braking. Laryngeal braking is thought to enhance oxygen uptake in the lungs. Thus, ultrasound may be an acoustic by-product of a respiratory maneuver that increases oxygen delivery to metabolically active tissues during cold exposure. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  keywords = {Animal Vocalizations,Body Temperature,Infants (Animal),Rats,Respiration,Temperature Effects}
}

