@article{nepomucenoElectromyographicStudySternocleidomastoid2014,
  title = {Electromyographic Study on the Sternocleidomastoid and Pectoralis Major Muscles during Respiratory Activity in Humans},
  author = {Nepomuceno, V. and Nepomuceno, E. and Regalo, S. and Cerqueira, E. and Souza, R.},
