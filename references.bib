  doi = {10.1186/s13229-020-00396-5},
  urldate = {2021-02-19},
  abstract = {Scanning faces is important for social interactions. Difficulty with the social use of eye contact constitutes one of the clinical symptoms of autism spectrum disorder (ASD). It has been suggested that individuals with ASD look less at the eyes and more at the mouth than typically developing (TD) individuals, possibly due to gaze aversion or gaze indifference. However, eye-tracking evidence for this hypothesis is mixed. While gaze patterns convey information about overt orienting processes, it is unclear how this is manifested at the neural level and how relative covert attention to the eyes and mouth of faces might be affected in ASD.},
  keywords = {asd,audiovisual,autism,eeg,eye-tracking,gesture,integration,mcgurk,multimodal,multisensory,synchrony}
