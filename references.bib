@article{whitfordNeurophysiologicalEvidenceEfference2017,
  title = {Neurophysiological Evidence of Efference Copies to Inner Speech},
  author = {Whitford, Thomas J and Jack, Bradley N and Pearson, Daniel and Griffiths, Oren and Luque, David and Harris, Anthony WF and Spencer, Kevin M and Le Pelley, Mike E},
  editor = {Ivry, Richard},
  year = {2017},
  month = dec,
  journal = {eLife},
  volume = {6},
  pages = {e28197},
  issn = {2050-084X},
  doi = {10.7554/eLife.28197},
  urldate = {2020-08-26},
  abstract = {Efference copies refer to internal duplicates of movement-producing neural signals. Their primary function is to predict, and often suppress, the sensory consequences of willed movements. Efference copies have been almost exclusively investigated in the context of overt movements. The current electrophysiological study employed a novel design to show that inner speech \textendash{} the silent production of words in one's mind \textendash{} is also associated with an efference copy. Participants produced an inner phoneme at a precisely specified time, at which an audible phoneme was concurrently presented. The production of the inner phoneme resulted in electrophysiological suppression, but only if the content of the inner phoneme matched the content of the audible phoneme. These results demonstrate that inner speech \textendash{} a purely mental action \textendash{} is associated with an efference copy with detailed auditory properties. These findings suggest that inner speech may ultimately reflect a special type of overt speech.},
  keywords = {corollary discharge,covert,covert speech,efference copy,imagery,imagined speech,inner speech,prediction,self,sensory attenuation}
}

