  issn = {1939-1277(ELECTRONIC),0096-1523(PRINT)},
  doi = {10.1037/0096-1523.7.5.1124},
  abstract = {Phonemic restoration is an illusion in which listeners hear spoken words as intact, even though parts of them have been replaced by an extraneous sound. An improved methodology with 60 Ss was used to investigate how much the illusion depends on the bottom-up confirmation of expectations generated at higher levels. A powerful bottom-up factor was phone class of the sound to be restored, and its acoustic similarity to the sound that replaced it. When white noise was the replacement sound, fricatives were better restored than vowels, whereas the pattern reversed with a pure tone replacement. Including a short silent period increased restoration of stop consonants. Data indicate that phonemic restoration depends on the interplay between the listener's expectations and the acoustic signal. (9 ref) (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  keywords = {Illusions (Perception),Phonemes,phonemic restoration,Speech Perception}
}

