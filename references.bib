@article{sawuschSpeakingRateNormalizationinprep.,
  title = {Speaking Rate Normalization Is a Speech-Specific Process},
  author = {Sawusch, James R. and Moore, Kathleen M. and Newman, Rochelle S.},
  year = {in prep.},
  abstract = {These studies investigated listeners' adjustment for speaking rate and segment duration variation.  In two studies, the stimuli were hybrid speech/tone syllables with variation in segment duration in the tone portion.  The tone portions could be heard as speech or nonspeech.  Listeners' expectations were manipulated using instructions emphasizing the speech or nonspeech origin of the tone segments.  A third study used amplitude-modulated noise which mimicked different speaking rates.  In all three cases, listeners judged the perception of a speech contrast.  An influence of duration variation was only found when the duration-varying portion of the signal was heard as speech.  These results indicate that speaking rate normalization and duration enhancement occur after the point in perception where perceptual grouping of the signal took place, and speech and nonspeech items were separated from one another.},
  keywords = {amplitude modulated noise,distal,general auditory,noise,nonspeech,preprint,proximal,ratenorm,sinewave speech,speech-specific,sws,vot}
}

@article{scarboroughOpticalPhoneticsVisual2009,
  title = {Optical {{Phonetics}} and {{Visual Perception}} of {{Lexical}} and {{Phrasal Stress}} in {{English}}},
  author = {Scarborough, Rebecca and Keating, Patricia and Mattys, Sven L. and Cho, Taehong and Alwan, Abeer},
  year = {2009},
  month = jun,
  journal = {Language and Speech},
  volume = {52},
  number = {2-3},
  pages = {135--175},
  issn = {0023-8309},
  doi = {10.1177/0023830909103165},
  urldate = {2019-11-12},
  abstract = {In a study of optical cues to the visual perception of stress, three American English talkers spoke words that differed in lexical stress and sentences that differed in phrasal stress, while video and movements of the face were recorded. The production of stressed and unstressed syllables from these utterances was analyzed along many measures of facial movement, which were generally larger and faster in the stressed condition. In a visual perception experiment, 16 perceivers identified the location of stress in forced-choice judgments of video clips of these utterances (without audio). Phrasal stress was better perceived than lexical stress. The relation of the visual intelligibility of the prosody of these utterances to the optical characteristics of their production was analyzed to determine which cues are associated with successful visual perception. While most optical measures were correlated with perception performance, chin measures, especially Chin Opening Displacement, contributed the most to correct perception independently of the other measures. Thus, our results indicate that the information for visual stress perception is mainly associated with mouth opening movements.},
  langid = {english},
  keywords = {audiovisual,lexical stress,prosody,suprasegmental,visual only}
}

@article{scarrExaminingTemporomandibularJoint2017,
  title = {Examining the Temporo-Mandibular Joint from a Biotensegrity Perspective: {{A}} Change in Thinking},
  shorttitle = {Examining the Temporo-Mandibular Joint from a Biotensegrity Perspective},
  author = {Scarr, Graham and Harrison, Helen},
